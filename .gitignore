# Build output
build/
*.o
*.so
*.obj

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Downloaded data / weights (large, and licensed separately).
# Keep the two instruction files, ignore every actual image/label/archive.
data/*
!data/README.md
!data/waste.yaml
models/*.pt
models/*.onnx
models/*.engine

# Nsight reports are multi-MB binaries; keep the generated stats text instead.
reports/*.nsys-rep
reports/*.ncu-rep
reports/*.sqlite

# Speaking / narration aids are for delivery, not repo documentation.
# They stay on disk locally but are never committed.
**/DEMO_SCRIPT.md
**/*SPEAKER_NOTES*
**/*SPEAKING_SCRIPT*
**/*TALK_TRACK*
